/-! ### R6-E: Picard / Chern infrastructure instances for `Ě_VII`

This section binds the abstract `LineBundleData` typeclass
(`HodgeReduction.Infrastructure.AlgebraicGeometry.LineBundle`,
landed by R6-A) to a **concrete Pic-model for the EVII compact dual**.

Mathematically:
* `Ě_VII` is a simply connected compact Hermitian symmetric space of
  compact type (dimension `27` over `ℂ`).
* `Pic(Ě_VII) ≅ ℤ`, generated by the canonical (very) ample line
  bundle `L` whose first Chern class is the Kähler class `h = X`.
* `Pic⁰(Ě_VII) = 0` (simply connected ⟹ `H¹(Ě_VII; 𝒪) = 0` ⟹
  `Pic⁰ = 0`), and therefore `NS(Ě_VII) ≅ Pic(Ě_VII) ≅ ℤ`.
* `c_1 : Pic(Ě_VII) → H²(Ě_VII; ℚ) ≅ ℚ·h` sends the generator `[L]` to
  `h = X`, and extends ℚ-linearly via `n ↦ n·h`.

We provide concrete content on a marker type `EVII_Space`
(disambiguated from `Unit`, which already carries
`LineBundleData.trivialBundleOnPoint`). The `Carrier` is `ℤ` —
recording the degree of a line bundle relative to the canonical `L`.
Tensor product corresponds to **addition of degrees**, the trivial
bundle to **degree `0`**, and dual to **negation of degree**. Two
line bundles are isomorphic iff they have the same degree (i.e., the
setoid relation is plain equality on `ℤ`), reflecting `Pic⁰ = 0`.

The two still-pending typeclasses
* `PicZeroData` (R6-B) — the trivial `Pic⁰` for simply connected `Ě_VII`,
* `FirstChernClassData` (R6-C) — the connecting map `c_1 : Pic → H²`,
are left as **well-commented TODO blocks**. They will land in
`Infrastructure/AlgebraicGeometry/{PicZero, FirstChernClass}.lean`
once R6-B/C complete; the wiring sketched here in comments will then
become live instances. -/

namespace EVII_R6

open HodgeReduction.Infrastructure.AlgebraicGeometry

/-- **Marker type for the EVII compact dual `Ě_VII`** (R6-E wiring).

We need a fresh type to attach a `LineBundleData` instance, because
`Unit` already carries the trivial-Pic instance
(`LineBundleData.trivialBundleOnPoint`). `EVII_Space` is a one-point
type morally identified with `Ě_VII` itself for the purposes of the
abstract `LineBundleData`/`PicZeroData`/`FirstChernClassData`
interfaces. -/
structure EVII_Space : Type where
  /-- The unique inhabitant — `Ě_VII` as a single carrier. -/
  point : Unit := ()

/-- **Concrete `LineBundleData EVII_Space`**: `Pic(Ě_VII) ≅ ℤ`.

* `Carrier := ℤ` — the degree of a line bundle relative to the
  canonical generator `L` of `Pic(Ě_VII)`.
* `trivial := 0` — the structure sheaf `𝒪_{Ě_VII}` has degree `0`.
* `tensor := (· + ·)` — tensor product adds degrees.
* `dual := Neg.neg` — dual negates degree.
* `iso := { r := Eq, … }` — two line bundles on `Ě_VII` are isomorphic
  iff they share a degree (true because `Pic⁰(Ě_VII) = 0`, so the
  degree map `Pic → ℤ` is injective; combined with `Pic ≅ ℤ` it is
  also surjective).

All six congruence/group laws (`tensor_respects_iso`,
`dual_respects_iso`, `tensor_trivial_left`, `tensor_dual_right`,
`tensor_comm`, `tensor_assoc`) reduce to standard ring lemmas on `ℤ`:
`add_zero`, `zero_add`, `neg_add_cancel`, `add_comm`, `add_assoc`,
`congrArg`. The instance is therefore kernel-pure (no new axioms). -/
noncomputable instance evii_lineBundleData : LineBundleData EVII_Space where
  Carrier := ℤ
  trivial := 0
  tensor := fun n m => n + m
  dual := fun n => -n
  iso :=
    { r := Eq
      iseqv :=
        { refl := fun _ => rfl
          symm := fun h => h.symm
          trans := fun h₁ h₂ => h₁.trans h₂ } }
  tensor_respects_iso := by
    intro L₁ L₂ M₁ M₂ hL hM
    exact congrArg₂ (· + ·) hL hM
  dual_respects_iso := by
    intro L M h
    exact congrArg Neg.neg h
  tensor_trivial_left := by
    intro L
    exact zero_add L
  tensor_dual_right := by
    intro L
    exact add_neg_cancel L
  tensor_comm := by
    intro L M
    exact add_comm L M
  tensor_assoc := by
    intro L M N
    exact add_assoc L M N

/-- The **canonical line bundle generator** `[L]` in `Pic(Ě_VII)`:
the line bundle of degree `1`. Its first Chern class equals the
Kähler class `h = X` (see `c1_evii_one` below). -/
noncomputable def L_canonical : LineBundleData.Carrier (X := EVII_Space) :=
  (1 : ℤ)

/-- **Closed-form first Chern class** for our `Ě_VII` model.

Defined directly on the `LineBundleData.Carrier (X := EVII_Space) = ℤ`
level, sending degree `n` to `n • X` in `A_EVII`. Once the abstract
`FirstChernClassData` typeclass (R6-C) lands, this will become the
underlying function of the instance `FirstChernClassData EVII_Space A_EVII`. -/
noncomputable def c1_evii (n : LineBundleData.Carrier (X := EVII_Space)) :
    A_EVII :=
  (n : ℚ) • (Polynomial.X : A_EVII)

/-- The first Chern class of the canonical line bundle `L` equals the
Kähler class `h = X`. -/
theorem c1_evii_canonical :
    c1_evii L_canonical = (Polynomial.X : A_EVII) := by
  unfold c1_evii L_canonical
  simp

/-- The first Chern class image lies in `H²(Ě_VII; ℚ) = ℚ·X` (the
`H2 := Submodule.span ℚ {X}` carrier of the existing
`Lefschetz11Data`). -/
theorem c1_evii_mem_H2 (n : ℤ) :
    c1_evii n ∈ Lefschetz11Data.H2 (A := A_EVII) := by
  unfold c1_evii
  -- `Lefschetz11Data.H2 = Submodule.span ℚ {X}`, so membership is
  -- exhibiting `n` as a ℚ-multiple of `X`.
  show (n : ℚ) • (Polynomial.X : A_EVII)
    ∈ Submodule.span ℚ ({(Polynomial.X : A_EVII)} : Set A_EVII)
  exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))

/-- The first Chern class image is algebraic — every `c_1(L^{⊗n})`
lies in the algebraic subring of `A_EVII`. This is a Pic-level
witness of the Lefschetz (1,1) algebraicity statement. -/
theorem c1_evii_isAlgebraic (n : ℤ) :
    CohomologyRing.IsAlgebraic (c1_evii n) := by
  unfold c1_evii
  exact CohomologyRing.isAlgebraic_smul (n : ℚ) X_isAlgebraic

/-- **Surjectivity of `c_1` onto `H^{1,1}` for `Ě_VII`**: every class
in `H^{1,1} = ℚ·X` is the image of `c_1` of some *rational* line bundle
class (i.e., a `ℚ`-scalar of the canonical generator).

Together with `c1_evii_isAlgebraic`, this gives the **Pic-side
algebraicity story** for the codim-1 Hodge-conjecture statement on
`Ě_VII`: every `H^{1,1}` class is `c_1` of a (rational) line bundle,
hence algebraic. -/
theorem c1_evii_image_eq_H11 :
    ∀ α ∈ Lefschetz11Data.H11 (A := A_EVII),
      ∃ r : ℚ, α = r • (Polynomial.X : A_EVII) := by
  intro α hα
  -- `Lefschetz11Data.H11 = Submodule.span ℚ {X}` for our concrete instance.
  rcases Submodule.mem_span_singleton.mp hα with ⟨r, rfl⟩
  exact ⟨r, rfl⟩

/-! ### Pending R6-B (PicZeroData) — TODO

`PicZeroData EVII_Space` will, once the typeclass lands in
`Infrastructure/AlgebraicGeometry/PicZero.lean`, witness that
`Pic⁰(Ě_VII) = 0`. The expected shape:

```lean
noncomputable instance evii_picZeroData : PicZeroData EVII_Space where
  picZero := ⊥                     -- the trivial subgroup of Pic
  picZero_closed := by trivial      -- (or the exact `Prop` field R6-B settles on)
```

with the mathematical content "Ě_VII is simply connected ⟹
`H¹(Ě_VII; 𝒪) = 0` ⟹ `Pic⁰ = 0`". This is **independent of R6-C**;
it depends only on R6-B fixing the `PicZeroData` typeclass signature.
-/

/-! ### R6-C LIVE: `FirstChernClassData EVII_Space A_EVII`

The `FirstChernClassData` typeclass (lifted to `Pic`-level rather than
`Carrier`-level) is in
`HodgeReduction.Infrastructure.AlgebraicGeometry.FirstChernClass`.

**Structural descent**. The carrier-level `c1_evii : ℤ → A_EVII` from
above lifts uniquely to a function `Pic EVII_Space → A_EVII` because
the iso relation on the carrier `ℤ` is **plain equality** (we set
`iso.r := Eq` in `evii_lineBundleData`, since `Pic⁰(Ě_VII) = 0`). Thus
the descent uses `Quotient.liftOn` with the trivial well-definedness
condition `(n m : ℤ) → n = m → c1_evii n = c1_evii m`, dispatched by
`congrArg`.

The three Chern-class identities reduce to identities about the integer
degree:
* `c_1(L ⊗ M) = c_1(L) + c_1(M)` ↦ `((m+n) : ℚ) • X = m•X + n•X` via
  `Int.cast_add + add_smul`.
* `c_1(𝒪_X) = 0` ↦ `((0:ℤ):ℚ) • X = 0` via `Int.cast_zero + zero_smul`.
* `c_1(L^∨) = -c_1(L)` ↦ `((-n):ℚ) • X = -(n•X)` via
  `Int.cast_neg + neg_smul`. -/

/-- Degree of a Pic class for our `Ě_VII` model: the integer carrier
descended through the (discrete-equality) iso quotient. Inverse to
`LineBundleData.classOf` on the canonical carrier `ℤ`. -/
noncomputable def evii_degree (L : Pic EVII_Space) : ℤ :=
  Quotient.liftOn L (fun (n : ℤ) => n) (fun _ _ h => h)

@[simp]
theorem evii_degree_classOf (n : ℤ) :
    evii_degree (LineBundleData.classOf (X := EVII_Space) n) = n := rfl

@[simp]
theorem evii_degree_one : evii_degree (1 : Pic EVII_Space) = 0 := rfl

@[simp]
theorem evii_degree_mul (L M : Pic EVII_Space) :
    evii_degree (L * M) = evii_degree L + evii_degree M := by
  refine Quotient.inductionOn₂ L M (fun m n => ?_)
  show evii_degree (LineBundleData.classOf (X := EVII_Space) m
                    * LineBundleData.classOf (X := EVII_Space) n)
      = evii_degree (LineBundleData.classOf (X := EVII_Space) m)
        + evii_degree (LineBundleData.classOf (X := EVII_Space) n)
  rw [LineBundleData.mul_classOf]
  rfl

@[simp]
theorem evii_degree_inv (L : Pic EVII_Space) :
    evii_degree L⁻¹ = - evii_degree L := by
  refine Quotient.inductionOn L (fun n => ?_)
  show evii_degree (LineBundleData.classOf (X := EVII_Space) n)⁻¹
      = - evii_degree (LineBundleData.classOf (X := EVII_Space) n)
  rw [LineBundleData.inv_classOf]
  rfl

/-- **Concrete `FirstChernClassData EVII_Space A_EVII`** (R27 STRUCTURAL).

* `H² := Submodule.span ℚ {X}` — the genuine one-dimensional `H^2` of
  `Ě_VII`.
* `c_1 L := (evii_degree L : ℚ) • X` — Pic-level Chern class via the
  integer degree of `L`.
* The three identities (`c1_tensor`, `c1_trivial`, `c1_dual`) reduce
  to integer-degree identities and discharge via `add_smul`,
  `zero_smul`, `neg_smul`. **No case-by-case**: one general descent,
  three general algebraic identities.

This closes the R6-C TODO and provides the **Pic-level c_1 connecting
homomorphism** for the concrete EVII instance — every line bundle now
has a well-defined Chern class living in the `H²` submodule. -/
noncomputable instance evii_firstChernClassData :
    FirstChernClassData EVII_Space A_EVII where
  H2 := Submodule.span ℚ ({(Polynomial.X : A_EVII)} : Set A_EVII)
  c1 := fun L => ((evii_degree L : ℤ) : ℚ) • (Polynomial.X : A_EVII)
  c1_in_H2 := by
    intro L
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))
  c1_tensor := by
    intro L M
    show ((evii_degree (L * M) : ℤ) : ℚ) • (Polynomial.X : A_EVII)
        = ((evii_degree L : ℤ) : ℚ) • (Polynomial.X : A_EVII)
          + ((evii_degree M : ℤ) : ℚ) • (Polynomial.X : A_EVII)
    rw [evii_degree_mul]
    push_cast
    rw [add_smul]
  c1_trivial := by
    show ((evii_degree (1 : Pic EVII_Space) : ℤ) : ℚ) • (Polynomial.X : A_EVII) = 0
    rw [evii_degree_one]
    simp
  c1_dual := by
    intro L
    show ((evii_degree L⁻¹ : ℤ) : ℚ) • (Polynomial.X : A_EVII)
        = - (((evii_degree L : ℤ) : ℚ) • (Polynomial.X : A_EVII))
    rw [evii_degree_inv]
    push_cast
    rw [neg_smul]

/-- **Sanity check**: `c_1` of the canonical generator (degree 1) is
the Kähler class `h = X` itself. -/
theorem evii_c1_canonical :
    FirstChernClassData.c1 (X := EVII_Space) (A := A_EVII)
        (LineBundleData.classOf (X := EVII_Space) L_canonical)
      = (Polynomial.X : A_EVII) := by
  show ((evii_degree (LineBundleData.classOf (X := EVII_Space) L_canonical) : ℤ) : ℚ)
        • (Polynomial.X : A_EVII)
      = (Polynomial.X : A_EVII)
  rw [evii_degree_classOf]
  show ((L_canonical : ℤ) : ℚ) • (Polynomial.X : A_EVII)
      = (Polynomial.X : A_EVII)
  unfold L_canonical
  simp

/-- **Pic-level Lefschetz (1,1) surjectivity** (R27 STRUCTURAL): every
class in `H² = ℚ·X` is in the image of `c_1 : Pic(Ě_VII) ⊗ ℚ → H²`,
i.e., is a rational scalar multiple of the canonical generator's Chern
class. This is the **Pic-side Lefschetz (1,1)** statement for `Ě_VII`. -/
theorem evii_H2_in_c1_image :
    ∀ α ∈ FirstChernClassData.H2 (X := EVII_Space) (A := A_EVII),
      ∃ r : ℚ, α = r • FirstChernClassData.c1 (X := EVII_Space) (A := A_EVII)
                          (LineBundleData.classOf (X := EVII_Space) L_canonical) := by
  intro α hα
  -- `H² = Submodule.span ℚ {X}` (from the instance), so membership gives `α = r • X`.
  rcases Submodule.mem_span_singleton.mp hα with ⟨r, rfl⟩
  refine ⟨r, ?_⟩
  rw [evii_c1_canonical]

/-! ### Sanity theorem: H^{1,1} = image of c_1 (Lefschetz-via-Picard form) -/

/-- **Concrete Lefschetz (1,1) for `Ě_VII` via `c_1`**.

Every class in `H^{1,1} = ℚ·h` (= `Lefschetz11Data.H11` on
`A_EVII`) is of the form `n • h` for some `n : ℚ`, and `h = c_1(L)`
for the canonical line bundle `L`. Hence every `H^{1,1}` class is in
the image of `c_1`, i.e., is algebraic in the genuine
Pic-modulo-Pic⁰ sense.

This makes our `Lefschetz11Data` instance no longer just "trivially
via `⊤`" but actually **realised as the image of `c_1`**: the
existence statement `∃ n : ℚ, α = n • X` is precisely the statement
that `α ∈ Set.range c1_evii` (after the obvious ℤ → ℚ identification
of the Pic carrier). -/
theorem evii_lefschetz_11_via_c1 :
    ∀ α ∈ Lefschetz11Data.H11 (A := A_EVII),
      ∃ n : ℚ, α = n • (Polynomial.X : A_EVII) := by
  intro α hα
  rcases Submodule.mem_span_singleton.mp hα with ⟨n, rfl⟩
  exact ⟨n, rfl⟩

/-- **Algebraicity of the c_1 image (Pic-side restatement of
Lefschetz (1,1))**. Combines `evii_lefschetz_11_via_c1` with
`c1_evii_isAlgebraic`: every `H^{1,1}` class is `c_1` of some rational
line-bundle class and therefore algebraic. This is the Pic-side
witness of the algebraicity content already provided by the
`Lefschetz11Data.lefschetz_11` field. -/
theorem evii_H11_isAlgebraic_via_c1 :
    ∀ α ∈ Lefschetz11Data.H11 (A := A_EVII),
      CohomologyRing.IsAlgebraic α := by
  intro α hα
  rcases evii_lefschetz_11_via_c1 α hα with ⟨n, rfl⟩
  exact CohomologyRing.isAlgebraic_smul n X_isAlgebraic

/-! ### R28 KERNEL-ONLY: Concrete `ChernOneData EVII_Space (Multiplicative ℤ)`

The R6-B `ChernOneData X H` typeclass packages `c_1 : Pic X →* H` as a
monoid homomorphism into a generic `CommGroup` target `H`. Previously
the framework provided a global default `chernOne_trivial X H` returning
`c_1 = 1` for ALL line bundles on ALL varieties — a degenerate
placeholder masking the absence of genuine `c_1` data. R28 demoted
`chernOne_trivial` from `instance` to `def` and we now provide the
**genuine `c_1`** for `Ě_VII`.

**Mathematical content**. For `Ě_VII = E_{7,C} / P_7` simply connected
compact Hermitian symmetric, `Pic(Ě_VII) ≅ ℤ` generated by the
canonical line bundle `L` whose first Chern class is the Kähler class
`h ∈ H²(Ě_VII; ℤ) ≅ ℤ`. The map `c_1 : Pic(Ě_VII) → ℤ` is therefore
the IDENTITY (after the canonical Pic ≅ ℤ ≅ H² identification), making
`c_1(L^n) = n` in additive ℤ. Packaged multiplicatively via
`Multiplicative ℤ` (the target of R6-B's `ChernOneData`), this is the
genuine degree hom — NOT the degenerate `c_1 = 1`.

**Pic⁰-vanishing**. Since `picZero EVII_Space = ⊥` (R6-B default
instance for the simply connected `Ě_VII`), the `c_1_picZero_le_ker`
field is vacuous: the only `L ∈ Pic⁰ = ⊥` is `L = 1`, on which `c_1`
returns `Multiplicative.ofAdd 0 = 1` by `map_one`. -/
noncomputable instance evii_chernOneData :
    ChernOneData EVII_Space (Multiplicative ℤ) where
  c₁ :=
    { toFun := fun L => Multiplicative.ofAdd (evii_degree L)
      map_one' := by
        show Multiplicative.ofAdd (evii_degree 1) = 1
        rw [evii_degree_one]
        rfl
      map_mul' := by
        intro L M
        show Multiplicative.ofAdd (evii_degree (L * M))
            = Multiplicative.ofAdd (evii_degree L)
              * Multiplicative.ofAdd (evii_degree M)
        rw [evii_degree_mul]
        rfl }
  c₁_picZero_le_ker := by
    -- R28 framework fix: `[PicZeroData EVII_Space]` is now a class
    -- parameter (not a field-internal quantifier), so this proof
    -- binds the specific outer instance — the default
    -- `picZero_trivial EVII_Space` with `picZero := ⊥`.
    -- Under `picZero = ⊥`, the only `L ∈ ⊥` is `1`, which the hom
    -- sends to `1`. Honest math: `Pic⁰(simply-conn HS-cpt) = 0` for
    -- `Ě_VII`, so this inclusion is exact.
    intro L hL
    have hL' : L ∈ (⊥ : Subgroup (Pic EVII_Space)) := hL
    rw [Subgroup.mem_bot] at hL'
    subst hL'
    show Multiplicative.ofAdd (evii_degree (1 : Pic EVII_Space)) = 1
    rw [evii_degree_one]
    rfl

/-- **Sanity check**: `c_1` of the canonical generator (degree 1) maps
to `Multiplicative.ofAdd 1` (= the multiplicative-1 in `Multiplicative ℤ`,
which is the additive 1). -/
theorem evii_c1MulHom_canonical :
    ChernOneData.c₁ (X := EVII_Space) (H := Multiplicative ℤ)
