noncomputable instance evii_twistedPhiFiltData :
    HodgeReduction.Infrastructure.Cohomology.TwistedPhiFiltData A_EVII where
  twistedPhiFilt_q := (-48 : ℚ) • ((Polynomial.X : A_EVII) ^ 4)
