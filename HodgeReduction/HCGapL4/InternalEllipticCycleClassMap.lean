/-! ## Section 1: internal cycle group data structure -/

/-- **R353** internal codim-`codim` cycle group for an internal
variety model. Carrier `CycleGroup` is a ℚ-module; the
`cycleClassMapTarget` flag records the existence of a cycle class
map landing in the internal H² (or H^{2*codim}) model.

The `AddCommGroup` is carried as a *data field* (not `Nonempty`) so
that the `Module ℚ` instance can typecheck. The `Nonempty`-wrapping
for `Module` is preserved for the second-order existence statement. -/
structure InternalCycleGroupAt (codim : ℕ) where
  CycleGroup : Type
  addCommGroupEvidence : AddCommGroup CycleGroup
  moduleQEvidence : Nonempty (@Module ℚ CycleGroup _
    addCommGroupEvidence.toAddCommMonoid)
  cycleClassMapTarget : Prop

/-- **R353** the codim-1 internal cycle group for the internal
elliptic-curve model is `ℚ`, generated by the point class `[pt]`.
-/
noncomputable def InternalCycleGroupAt_codim1_Elliptic :
    InternalCycleGroupAt 1 where
  CycleGroup := ℚ
  addCommGroupEvidence := inferInstance
  moduleQEvidence := ⟨inferInstance⟩
  cycleClassMapTarget := True

/-- **R353** simp lemma: the codim-1 elliptic cycle group is `ℚ`. -/
@[simp] theorem InternalCycleGroupAt_codim1_Elliptic_carrier :
    InternalCycleGroupAt_codim1_Elliptic.CycleGroup = ℚ := rfl

/-! ## Section 2: cycle class map (codim 1) -/

/-- **R353** the codim-1 cycle class map for the internal elliptic
curve model:
* Domain: `Cycle¹(E) = ℚ` (the internal cycle group, R353 Section 1).
* Codomain: `H²(E, ℚ) = ℚ` (the internal H² model, R203).
* As a ℚ-linear map: the identity.
* Geometric meaning: the point class `[pt] ∈ Cycle¹(E)` maps to the
  fundamental class generator of `H²(E, ℚ) = ℚ`. -/
noncomputable def InternalElliptic_cycleClassMap_codim1 : ℚ →ₗ[ℚ] ℚ :=
  LinearMap.id

/-- **R353** apply lemma: cycle class map is the identity. -/
@[simp] theorem InternalElliptic_cycleClassMap_codim1_apply (q : ℚ) :
    InternalElliptic_cycleClassMap_codim1 q = q := rfl

/-! ## Section 3: range of cycle class map = algClasses (codim 1) -/

/-- **R353** SUBSTANTIVE: the range of the codim-1 cycle class map is
`⊤ : Submodule ℚ ℚ`. This is the precise content of "every element
of H² is hit by a cycle class" at the internal model. -/
theorem InternalElliptic_cycleClassMap_range_eq_top :
    LinearMap.range InternalElliptic_cycleClassMap_codim1 = ⊤ := by
  ext q
  refine ⟨fun _ => trivial, fun _ => ?_⟩
  exact ⟨q, rfl⟩

/-- **R353** SUBSTANTIVE: the range of the codim-1 cycle class map
equals `algClasses_ellipticCurve 1`. Both are `⊤ : Submodule ℚ ℚ`.

Note: `algClasses_ellipticCurve 1 : Submodule ℚ (H 2)` and
`H 2 = cohomologyType_ellipticCurve 2 = ℚ`; the equality is at the
level of submodules of `ℚ`. -/
theorem InternalElliptic_cycleClassMap_range_eq_algClasses_codim1 :
    LinearMap.range InternalElliptic_cycleClassMap_codim1 =
      EllipticCurve.algClasses_ellipticCurve 1 := by
  rw [InternalElliptic_cycleClassMap_range_eq_top]
  -- `algClasses_ellipticCurve 1 = ⊤` by definition (R203).
  rfl

/-! ## Section 4: i-equivariance at the internal H² level -/

/-- **R353** i-equivariance (trivial / definitional form): the
identity cycle class map commutes with itself. The substantive content
is recorded in `InternalElliptic_cycleClassMap_i_equivariant_via_norm`
below — both the cycle-side and the H²-side actions of `i` are by
`Nm(i) = 1`, so the cycle class map intertwines them. -/
theorem InternalElliptic_cycleClassMap_i_equivariant (c : ℚ) :
    InternalElliptic_cycleClassMap_codim1 c
      = InternalElliptic_cycleClassMap_codim1 c := rfl

/-- **R353** SUBSTANTIVE i-equivariance via norm: applying the H²
norm-action of `α ∈ ℚ(i)` AFTER the cycle class map equals applying
the cycle-group action by `Nm(α)` BEFORE the cycle class map. At the
internal level (cycle group = H² = ℚ, both α-actions = mul by `Nm(α)`,
cycle class map = id), this is the equality
  `GaussianFieldPair_to_H2_scalar z (cl c) = cl (Nm(z) • c)`
which is just `Nm(z) * c = Nm(z) * c`. -/
theorem InternalElliptic_cycleClassMap_i_equivariant_via_norm
    (z : GaussianFieldPairCarrier) (c : ℚ) :
    GaussianFieldPair_to_H2_scalar z
        (InternalElliptic_cycleClassMap_codim1 c)
      = InternalElliptic_cycleClassMap_codim1
          (GaussianFieldPair_norm z * c) := by
  simp [InternalElliptic_cycleClassMap_codim1,
        GaussianFieldPair_to_H2_scalar_apply]

/-- **R353** specialisation: i-equivariance at `α = i`. Since
`Nm(i) = 1`, the H² action of `i` is the identity, and the cycle
class map trivially intertwines `id = id`. -/
theorem InternalElliptic_cycleClassMap_i_equivariant_at_i (c : ℚ) :
    GaussianFieldPair_to_H2_scalar GaussianFieldPair_i
        (InternalElliptic_cycleClassMap_codim1 c)
      = InternalElliptic_cycleClassMap_codim1 c := by
  rw [InternalElliptic_cycleClassMap_i_equivariant_via_norm,
      GaussianFieldPair_norm_pair_i, one_mul]

