  rank : ℕ → ℕ
  /-- Witness: degree-0 rank equals 1. -/
  rank0_eq_one : rank 0 = 1
  /-- Target: degree-1 rank claim. -/
  rank1Target : Prop
  /-- Target: degree-2 rank claim. -/
  rank2Target : Prop

/-- **R417 current rank spec instance**: minimal placeholder rank
function `rank k := if k = 0 then 1 else 0`. NOT the real E_7
ranks — just the smallest instance satisfying `rank 0 = 1`. -/
def E7RankLowDegreeSpec_current : E7RankLowDegreeSpec where
  rank := fun k => if k = 0 then 1 else 0
  rank0_eq_one := by simp
  rank1Target := True
  rank2Target := True

/-! ## Section 5: rank0 LA closure for the current spec -/

/-- **R417 LA closure** specialised to `E7RankLowDegreeSpec_current`:
the degree-0 carrier is ℚ-linearly equivalent to ℚ. KERNEL-PURE. -/
theorem DegreewiseRank_rank0_one_profile_closes_current :
    Nonempty (DegreewiseRankE7_H E7RankLowDegreeSpec_current.rank 0
      ≃ₗ[ℚ] ℚ) :=
  DegreewiseRank_rank0_one_profile_closes
    E7RankLowDegreeSpec_current.rank
    E7RankLowDegreeSpec_current.rank0_eq_one

