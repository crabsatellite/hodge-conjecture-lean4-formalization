/-- **R765 substantive theorem (1/6)**: a nonzero subspace contained in the
line generated by `j_q(h^4)` contains that line generator. -/
theorem targetGenerator_mem_of_target_invariants_le_line_and_exists_nonzero
    (hline :
      LE.le (MatsushimaData.target_invariants (A := A) (B := B))
        (Submodule.span Rat
          {MatsushimaData.j_q (A := A) (B := B)
            ((KaehlerClass.h : A) ^ 4)}))
    (hnonzero :
      Exists fun beta : B =>
        (MatsushimaData.target_invariants (A := A) (B := B)).carrier beta /\
          Not (beta = 0)) :
    (MatsushimaData.target_invariants (A := A) (B := B)).carrier
      (MatsushimaData.j_q (A := A) (B := B)
        ((KaehlerClass.h : A) ^ 4)) := by
  obtain ⟨beta, hbeta_target, hbeta_ne⟩ := hnonzero
  have hbeta_line :
      beta ∈
        Submodule.span Rat
          {MatsushimaData.j_q (A := A) (B := B)
            ((KaehlerClass.h : A) ^ 4)} :=
    hline hbeta_target
  rw [Submodule.mem_span_singleton] at hbeta_line
  obtain ⟨r, hr⟩ := hbeta_line
  let targetGenerator : B :=
    MatsushimaData.j_q (A := A) (B := B)
      ((KaehlerClass.h : A) ^ 4)
  have hr_target : r • targetGenerator = beta := by
    simpa [targetGenerator] using hr
  have hr_ne : r ≠ 0 := by
    intro hr_zero
    apply hbeta_ne
    calc
      beta = r • targetGenerator := hr_target.symm
      _ = 0 := by simp [targetGenerator, hr_zero]
  have hgen_eq_inv_smul_beta :
      targetGenerator = r⁻¹ • beta := by
    calc
      targetGenerator = 1 • targetGenerator := by simp
      _ = (r⁻¹ * r) • targetGenerator := by
        rw [inv_mul_cancel₀ hr_ne]
        simp
      _ = r⁻¹ • (r • targetGenerator) := by
        simp [mul_smul]
      _ = r⁻¹ • beta := by
        rw [hr_target]
  dsimp [targetGenerator] at hgen_eq_inv_smul_beta
  rw [hgen_eq_inv_smul_beta]
  exact Submodule.smul_mem
    (MatsushimaData.target_invariants (A := A) (B := B)) r⁻¹ hbeta_target

/-- **R765 substantive theorem (2/6)**: the same nonzero witness can be given
on `trivialModulePart`, using the existing R554 equality
`target_invariants = trivialModulePart`. -/
theorem targetGenerator_mem_of_target_invariants_le_line_and_exists_nonzero_trivialModulePart
    (hline :
      LE.le (MatsushimaData.target_invariants (A := A) (B := B))
        (Submodule.span Rat
          {MatsushimaData.j_q (A := A) (B := B)
            ((KaehlerClass.h : A) ^ 4)}))
    (hnonzero :
      Exists fun beta : B =>
        (CuspidalCohomologyData.trivialModulePart (A := B)).carrier beta /\
          Not (beta = 0)) :
    (MatsushimaData.target_invariants (A := A) (B := B)).carrier
      (MatsushimaData.j_q (A := A) (B := B)
        ((KaehlerClass.h : A) ^ 4)) := by
  apply targetGenerator_mem_of_target_invariants_le_line_and_exists_nonzero
    (A := A) (B := B) hline
  obtain ⟨beta, hbeta_trivial, hbeta_ne⟩ := hnonzero
  exact ⟨beta, by
    simpa [target_invariants_eq_trivialModulePart (A := A) (B := B)]
      using hbeta_trivial, hbeta_ne⟩

