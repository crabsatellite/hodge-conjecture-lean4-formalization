containment, and target nonzero prove the R763 generator/source containment. -/
theorem H8_le_source_invariants_of_boundaryData_targetLine_and_targetNonzero
    (D : MatsushimaV56BoundaryData A B)
    (hline :
      LE.le (MatsushimaData.target_invariants (A := A) (B := B))
        (Submodule.span Rat
          {MatsushimaData.j_q (A := A) (B := B)
            ((KaehlerClass.h : A) ^ 4)}))
    (hnonzero :
      Exists fun beta : B =>
        (MatsushimaData.target_invariants (A := A) (B := B)).carrier beta /\
          Not (beta = 0)) :
    LE.le (CompactDualData.H8 (A := A))
      (MatsushimaData.source_invariants (A := A) (B := B)) :=
  H8_le_source_invariants_of_boundaryData_targetGenerator_mem
    (A := A) (B := B) D
    (targetGenerator_mem_of_target_invariants_le_line_and_exists_nonzero
      (A := A) (B := B) hline hnonzero)

