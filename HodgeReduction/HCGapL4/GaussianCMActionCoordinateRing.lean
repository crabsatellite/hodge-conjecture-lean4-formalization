/-! ## Section 1: coordinate-polynomial preservation -/

/-- **R310** the polynomial identity expressing that the substitution
`(x, y) ↦ (-x, i·y)` sends `Y² - X³ - X` to `-(Y² - X³ - X)` over
`K = GaussianRationalFieldCandidate`.

Proof: expand `(i·y)² = i²·y² = -y²` using R285, then linear
combination:
  `(i·y)² - (-x)³ - (-x) = -y² + x³ + x = -(y² - x³ - x)`. -/
theorem gaussianCMAction_coordinate_polynomial_preserves
    (x y : GaussianRationalFieldCandidate) :
    (gaussianRationalI * y)^2 - (-x)^3 - (-x)
      = -(y^2 - x^3 - x) := by
  have hi : (gaussianRationalI : GaussianRationalFieldCandidate)^2 = -1 :=
    gaussianRationalI_sq_eq_neg_one
  linear_combination y^2 * hi

/-- **R310** corollary: on the zero locus, the CM substitution
preserves the equation `Y² - X³ - X = 0`.

Proof: rewrite via `gaussianCMAction_coordinate_polynomial_preserves`,
then substitute `h` and simplify `-0 = 0`. -/
theorem gaussianCMAction_coordinate_polynomial_preserves_zero
    (x y : GaussianRationalFieldCandidate)
    (h : y^2 - x^3 - x = 0) :
    (gaussianRationalI * y)^2 - (-x)^3 - (-x) = 0 := by
  rw [gaussianCMAction_coordinate_polynomial_preserves, h, neg_zero]

/-! ## Section 2: ideal-level target (marker only) -/

/-- **R310 target**: the principal ideal generated by `Y² - X³ - X`
in `K[X, Y]` is sent into itself under the substitution
`X ↦ -X, Y ↦ i·Y`. Equivalently, the generator is mapped to `-1`
times itself, which lies in the same ideal.

This is the IDEAL-THEORETIC reformulation of
`gaussianCMAction_coordinate_polynomial_preserves`. Closing it would
require importing `Mathlib.RingTheory.MvPolynomial.Basic` and Ideal
API, which is heavy machinery the function-level identity does not
need. -/
def Target_gaussianCMAction_coordinateRing_preserves_principalIdeal :
    Prop := True

