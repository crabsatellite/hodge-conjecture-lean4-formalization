/-- **R703 substantive theorem (1/6)**: the R646/R702 Cartan-image contract
feeds the R691 generator-line contract. -/
def sourceBoundaryLineContainmentContract_of_cartanImageUpperBoundContract
    (O : EVIIH8ResidualCartanImageUpperBoundContract A B) :
    EVIIH8ResidualSourceBoundaryLineContainmentContract A B where
  source_eq_compactDual :=
    (source_eq_compactDual_iff_sourceInvariantExactImageTarget
      (A := A) (B := B)).2 O.source_invariants_exact_image
  h_pow_four_mem_source_invariants :=
    h_pow_four_mem_source_invariants_of_source_invariants_eq_H8
      (A := A) (B := B) O.source_invariants_eq_H8
  trivialModulePart_le_h_pow_four_line := by
    simpa [cartan_image_eq_span_matsushima_h_pow_four (A := A) (B := B)]
      using O.trivialModulePart_le_cartanImage

/-- **R703 substantive theorem (2/6)**: conversely, the R691 generator-line
contract feeds the R646/R702 Cartan-image contract. -/
def cartanImageUpperBoundContract_of_sourceBoundaryLineContainmentContract
    (O : EVIIH8ResidualSourceBoundaryLineContainmentContract A B) :
    EVIIH8ResidualCartanImageUpperBoundContract A B where
  source_invariants_exact_image :=
    (source_eq_compactDual_iff_sourceInvariantExactImageTarget
      (A := A) (B := B)).1 O.source_eq_compactDual
  source_invariants_eq_H8 := by
    haveI :
        FiniteDimensional Rat
          (CuspidalCohomologyData.trivialModulePart (A := B)) :=
      trivialModulePart_finiteDimensional_of_h_pow_four_mem_source_lineContainment
        (A := A) (B := B)
        O.h_pow_four_mem_source_invariants
        O.trivialModulePart_le_h_pow_four_line
    exact
      source_invariants_eq_H8_of_h_pow_four_mem_source_trivialModulePartUpperBound
      (A := A) (B := B)
      O.h_pow_four_mem_source_invariants
      (trivialModulePart_upper_bound_of_h_pow_four_mem_source_lineContainment
        (A := A) (B := B)
        O.h_pow_four_mem_source_invariants
        O.trivialModulePart_le_h_pow_four_line)
  trivialModulePart_le_cartanImage := by
    simpa [cartan_image_eq_span_matsushima_h_pow_four (A := A) (B := B)]
      using O.trivialModulePart_le_h_pow_four_line

/-- **R703 substantive theorem (3/6)**: the Cartan-image route and the
generator-line route are the same inhabited residual contract. -/
theorem residual_cartanImageUpperBound_nonempty_iff_sourceBoundaryLineContainment_nonempty :
    Nonempty (EVIIH8ResidualCartanImageUpperBoundContract A B) <->
      Nonempty (EVIIH8ResidualSourceBoundaryLineContainmentContract A B) :=
  Iff.intro
    (fun h =>
      h.elim (fun O =>
        Nonempty.intro
          (sourceBoundaryLineContainmentContract_of_cartanImageUpperBoundContract
            (A := A) (B := B) O)))
    (fun h =>
      h.elim (fun O =>
        Nonempty.intro
          (cartanImageUpperBoundContract_of_sourceBoundaryLineContainmentContract
            (A := A) (B := B) O)))

/-- **R703 substantive theorem (4/6)**: a Cartan-image contract also rebuilds
the preferred R694 boundary-data/source-H8 contract. -/
def boundaryDataSourceSurjectivityContract_of_cartanImageUpperBoundContract
    (O : EVIIH8ResidualCartanImageUpperBoundContract A B) :
    EVIIH8ResidualBoundaryDataSourceSurjectivityContract A B := by
  let F : EVIIH8ResidualFiniteTrivialMultiplicityContract A B :=
    finiteTrivialMultiplicityContract_of_cartanImageUpperBoundContract
      (A := A) (B := B) O
  let D : MatsushimaV56BoundaryData A B :=
    boundaryData_of_finiteTrivialMultiplicityContract (A := A) (B := B) F
  exact
    { boundary := D
      surjectivity_source_eq_H8 :=
        (surjectivity_source_eq_H8_iff_source_invariants_eq_H8_of_boundaryData
          (A := A) (B := B) D).2 O.source_invariants_eq_H8 }

/-- **R703 substantive theorem (5/6)**: conversely, the R694
boundary-data/source-H8 route rebuilds the R646/R702 Cartan-image contract. -/
def cartanImageUpperBoundContract_of_boundaryDataSourceSurjectivityContract
    (O : EVIIH8ResidualBoundaryDataSourceSurjectivityContract A B) :
    EVIIH8ResidualCartanImageUpperBoundContract A B where
  source_invariants_exact_image :=
    (source_eq_compactDual_iff_sourceInvariantExactImageTarget
      (A := A) (B := B)).1 O.boundary.source_eq_compactDual
  source_invariants_eq_H8 :=
    source_invariants_eq_H8_of_boundaryData_surjectivity_source_eq_H8
      (A := A) (B := B) O.boundary O.surjectivity_source_eq_H8
  trivialModulePart_le_cartanImage := by
    have hline :
        CuspidalCohomologyData.trivialModulePart (A := B) <=
          Submodule.span Rat
            {MatsushimaData.j_q (A := A) (B := B)
              ((KaehlerClass.h : A) ^ 4)} :=
      trivialModulePart_le_h_pow_four_line_of_boundaryData_surjectivity_source_eq_H8
        (A := A) (B := B) O.boundary O.surjectivity_source_eq_H8
    simpa [cartan_image_eq_span_matsushima_h_pow_four (A := A) (B := B)]
      using hline

/-- **R703 substantive theorem (6/6)**: the Cartan-image route and the R694
boundary-data/source-H8 route are equivalent inhabited residual contracts. -/
theorem residual_cartanImageUpperBound_nonempty_iff_boundaryDataSourceSurjectivity_nonempty :
    Nonempty (EVIIH8ResidualCartanImageUpperBoundContract A B) <->
      Nonempty (EVIIH8ResidualBoundaryDataSourceSurjectivityContract A B) :=
  Iff.intro
    (fun h =>
      h.elim (fun O =>
        Nonempty.intro
          (boundaryDataSourceSurjectivityContract_of_cartanImageUpperBoundContract
            (A := A) (B := B) O)))
    (fun h =>
      h.elim (fun O =>
        Nonempty.intro
          (cartanImageUpperBoundContract_of_boundaryDataSourceSurjectivityContract
            (A := A) (B := B) O)))

